# Rust build output
**/target/

# Cargo lock (kept for binary projects)
# Cargo.lock

# Environment variables
.env
.env.*
.env.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.AppleDouble
Thumbs.db
ehthumbs.db
Desktop.ini

# Compiled binaries
*.exe
*.pdb
*.d

# Standalone binaries compiled directly with `rustc` (no Cargo/target dir),
# e.g. early exercises before a module has its own Cargo project
module-*/*
!module-*/*.*
!module-*/*/
